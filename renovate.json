{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base", ":disableDependencyDashboard"],
  "packageRules": [
    {
      "matchPackagePatterns": ["^gittools"],
      "allowedVersions": "<4"
    },
    {
      "matchPackageNames": ["dotnet-sdk"],
      "matchUpdateTypes": ["patch"],
      "enabled": false,
      "description": "Using automatic roll-forward instead of explicit update"
    },
    {
      "matchPackagePatterns": ["Test", "Assert", "Mock", "[Xx]unit", "Moq"],
      "groupName": "Testing deps",
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "matchPackagePatterns": ["^NanoByte\\.CodeGeneration"],
      "groupName": "NanoByte.CodeGeneration",
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "matchPackagePatterns": ["docfx", "SourceLink", "OpenApi"],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "description": "The generator must reference the oldest Roslyn it needs; hosts running an older compiler (e.g. docfx) refuse to load analyzers that reference a newer one",
      "matchPackageNames": ["Microsoft.CodeAnalysis.CSharp"],
      "matchFileNames": ["src/TypedRest.SourceGenerator/TypedRest.SourceGenerator.csproj"],
      "allowedVersions": "<4.9"
    },
    {
      "matchPackageNames": ["TypedRest"],
      "groupName": "C# smoke testing deps",
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "matchDatasources": ["maven"],
      "groupName": "Java smoke testing deps",
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "matchDatasources": ["npm"],
      "groupName": "TypeScript smoke testing deps",
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "description": "TypedRest for TypeScript is currently pinned to url-template 2.x",
      "matchPackagePatterns": ["url-template$"],
      "allowedVersions": "<3"
    }
  ]
}
