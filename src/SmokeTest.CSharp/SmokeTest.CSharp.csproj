<Project Sdk="Microsoft.NET.Sdk">

  <!-- Project properties -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <IsPackable>False</IsPackable>
    <GenerateDocumentationFile>False</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- This project consumes the generated client, not the OpenAPI model, so drop the shared global usings -->
  <ItemGroup>
    <Using Remove="Microsoft.OpenApi;Microsoft.OpenApi.Any;Microsoft.OpenApi.Extensions;Microsoft.OpenApi.Interfaces;Microsoft.OpenApi.Models;Microsoft.OpenApi.Readers;Microsoft.OpenApi.Writers" />
  </ItemGroup>

  <!-- Dependencies -->
  <ItemGroup>
    <ProjectReference Include="..\TypedRest.SourceGenerator\TypedRest.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="False" AdditionalProperties="_FlowAnalyzerDependencies=true" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="TypedRest" Version="1.7.0" />
  </ItemGroup>

  <!-- Simulates what consumers get from the NuGet package -->
  <Import Project="..\TypedRest.SourceGenerator\build\TypedRest.SourceGenerator.props" />

  <ItemGroup>
    <TypedRestOpenApi Include="..\UnitTests\sample-v3.yml" ServiceName="Sample" Namespace="SmokeTest.CSharp.Client" />
    <TypedRestOpenApi Include="..\UnitTests\sample-nested.yml" ServiceName="Nested" Namespace="SmokeTest.CSharp.NestedClient" />
  </ItemGroup>

  <!-- Simulates what consumers get from the NuGet package -->
  <Import Project="..\TypedRest.SourceGenerator\build\TypedRest.SourceGenerator.targets" />

</Project>
